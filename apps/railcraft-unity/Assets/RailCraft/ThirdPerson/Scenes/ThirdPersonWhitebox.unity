  m_Name: 
  m_EditorClassIdentifier: RailCraft.ThirdPerson.World::RailCraft.ThirdPerson.World.QuizPartStation
  sessionHost: {fileID: 443481445}
  inputLock: {fileID: 1287648357}
  quizDialogBehaviour: {fileID: 1538379279}
  questions:
  - questionId: bank_mc14
    prompt: "\u52A8\u8F66\u7EC4\u7275\u5F15\u7CFB\u7EDF\u7684\u4E3B\u8981\u529F\u80FD\u662F\uFF1F"
    options:
    - "\u5C06\u5217\u8F66\u52A8\u80FD\u8F6C\u6362\u4E3A\u7535\u80FD\u50A8\u5B58"
    - "\u4EC5\u7528\u4E8E\u7D27\u6025\u5236\u52A8"
    - "\u63A7\u5236\u8F66\u95E8\u5F00\u5173"
    - "\u5C06\u63A5\u89E6\u7F51\u7535\u80FD\u8F6C\u6362\u4E3A\u5217\u8F66\u52A8\u80FD"
    submittedOptionIndices: 01000000020000000300000000000000
    explanation: "\u7275\u5F15\u7CFB\u7EDF\u901A\u8FC7\u53D7\u7535\u5F13\u53D6\u7535\uFF0C\u7ECF\u53D8\u6D41\u5668\u9A71\u52A8\u7275\u5F15\u7535\u673A\uFF0C\u5C06\u7535\u80FD\u8F6C\u5316\u4E3A\u52A8\u80FD\uFF1BB\u662F\u518D\u751F\u5236\u52A8\u529F\u80FD\uFF1BD\u4E0E\u7275\u5F15\u7CFB\u7EDF\u65E0\u5173\u3002"
  - questionId: bank_mc28
    prompt: "\u9AD8\u94C1\u5217\u8F66\u7684\u9AD8\u538B\u9694\u79BB\u5F00\u5173\u5728\u7535\u6C14\u7CFB\u7EDF\u4E2D\u7684\u4E3B\u8981\u4F5C\u7528\u662F\uFF1F"
    options:
    - "\u8C03\u8282\u4F9B\u7535\u7535\u538B"
    - "\u63A7\u5236\u7275\u5F15\u7535\u673A\u8F6C\u901F"
    - "\u9694\u79BB\u6545\u969C\u7684\u9AD8\u538B\u8BBE\u5907\uFF0C\u4FDD\u8BC1\u5B89\u5168\u68C0\u4FEE"
    - "\u5C06\u4EA4\u6D41\u7535\u8F6C\u6362\u4E3A\u76F4\u6D41\u7535"
    submittedOptionIndices: 02000000030000000000000001000000
    explanation: "\u9AD8\u538B\u9694\u79BB\u5F00\u5173\u7528\u4E8E\u5728\u68C0\u4FEE\u6216\u6545\u969C\u65F6\u9694\u79BB\u9AD8\u538B\u8BBE\u5907\uFF0C\u5F62\u6210\u660E\u663E\u65AD\u53E3\uFF0C\u786E\u4FDD\u4EBA\u5458\u5B89\u5168\uFF1BB\u3001C\u3001D\u5206\u522B\u4E3A\u53D8\u6D41\u5668\u3001\u53D8\u538B\u5668\u548C\u53D8\u6D41\u5668\u529F\u80FD\u3002"
  - questionId: bank_mc42
    prompt: "\u72B6\u6001\u76D1\u6D4B\u7CFB\u7EDF\u5728\u8F6C\u5411\u67B6\u8FD0\u7EF4\u4E2D\u7684\u6838\u5FC3\u4EF7\u503C\u662F\uFF1F"
    options:
    - "\u4EC5\u7528\u4E8E\u8BB0\u5F55\u5386\u53F2\u6570\u636E"
    - "\u5B8C\u5168\u53D6\u4EE3\u4EBA\u5DE5\u5DE1\u68C0"
    - "\u5B9E\u65F6\u76D1\u6D4B\u5173\u952E\u53C2\u6570\uFF0C\u5B9E\u73B0\u89C6\u60C5\u7EF4\u4FEE\uFF0C\u907F\u514D\u7EF4\u4FEE\u4E0D\u8DB3\u6216\u8FC7\u5269"
    - "\u589E\u52A0\u7EF4\u4FEE\u5DE5\u4F5C\u91CF"
    submittedOptionIndices: 03000000000000000100000002000000
    explanation: "\u72B6\u6001\u76D1\u6D4B\u4E3A\u89C6\u60C5\u7EF4\u4FEE\u63D0\u4F9B\u6570\u636E\u652F\u6491\uFF0C\u5728\u6545\u969C\u65E9\u671F\u9884\u8B66\uFF0C\u907F\u514D\u8BA1\u5212\u7EF4\u4FEE\u7684\u201C\u8FC7\u4FEE\u201D\u6216\u201C\u5931\u4FEE\u201D\u3002"
  - questionId: bank_tf06
    prompt: "\u6570\u5B57\u5B6A\u751F\u6280\u672F\u4EC5\u7528\u4E8E\u4EA7\u54C1\u8BBE\u8BA1\u9636\u6BB5\uFF0C\u5728\u8FD0\u7EF4\u9636\u6BB5\u6CA1\u6709\u5B9E\u9645\u5E94\u7528\u4EF7\u503C\u3002"
    options:
    - "\u6B63\u786E"
    - "\u9519\u8BEF"
    submittedOptionIndices: 0000000001000000
    explanation: "\u6570\u5B57\u5B6A\u751F\u5728\u8FD0\u7EF4\u9636\u6BB5\u4EF7\u503C\u5DE8\u5927\uFF0C\u53EF\u7528\u4E8E\u72B6\u6001\u76D1\u6D4B\u3001\u6545\u969C\u9884\u6D4B\u3001\u865A\u62DF\u68C0\u4FEE\u57F9\u8BAD\u548C\u7EF4\u4FEE\u51B3\u7B56\u4F18\u5316\u3002"
  rewardPart: 13
  stationDisplayName: "\u4E2D\u592E\u7275\u5F15\u88C5\u7F6E\u77E5\u8BC6\u5DE5\u4F4D"
