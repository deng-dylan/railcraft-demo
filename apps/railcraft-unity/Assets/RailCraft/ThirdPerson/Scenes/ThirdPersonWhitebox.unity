  m_Name: 
  m_EditorClassIdentifier: RailCraft.ThirdPerson.World::RailCraft.ThirdPerson.World.QuizPartStation
  sessionHost: {fileID: 443481445}
  inputLock: {fileID: 1287648357}
  quizDialogBehaviour: {fileID: 1538379279}
  questions:
  - questionId: bank_mc04
    prompt: "\u8F6E\u5BF9\u5728\u8F6C\u5411\u67B6\u4E2D\u7684\u4F5C\u7528\u662F\uFF1F"
    options:
    - "\u5B89\u88C5\u5236\u52A8\u88C5\u7F6E"
    - "\u8FDE\u63A5\u8F66\u4F53\u4E0E\u8F6C\u5411\u67B6"
    - "\u76F4\u63A5\u4E0E\u94A2\u8F68\u63A5\u89E6\uFF0C\u4F20\u9012\u8F7D\u8377\u5E76\u4EA7\u751F\u7275\u5F15/\u5236\u52A8\u529B"
    - "\u7F13\u548C\u7EBF\u8DEF\u51B2\u51FB"
    submittedOptionIndices: 03000000000000000100000002000000
    explanation: "\u8F6E\u5BF9\u7531\u8F66\u8F6E\u548C\u8F66\u8F74\u7EC4\u6210\uFF0C\u76F4\u63A5\u4E0E\u94A2\u8F68\u63A5\u89E6\uFF0C\u627F\u53D7\u5782\u5411\u8F7D\u8377\uFF0C\u5E76\u901A\u8FC7\u8F6E\u8F68\u9ECF\u7740\u4F20\u9012\u7275\u5F15\u529B\u548C\u5236\u52A8\u529B\u3002A\u662F\u4E8C\u7CFB\u60AC\u6302\u6216\u7275\u5F15\u62C9\u6746\u7684\u529F\u80FD\uFF0CC\u662F\u5F39\u7C27\u60AC\u6302\u7CFB\u7EDF\u7684\u529F\u80FD\uFF0CD\u867D\u662F\u8F6E\u5BF9\u7684\u529F\u80FD\u4E4B\u4E00\u4F46\u4E0D\u662F\u6700\u4E3B\u8981\u7684\u4F5C\u7528\u3002"
  - questionId: bank_mc18
    prompt: "\u9AD8\u94C1\u5217\u8F66\u7684\u8F85\u52A9\u4F9B\u7535\u7CFB\u7EDF\uFF08\u5982\u84C4\u7535\u6C60\uFF09\u5728\u6B63\u5E38\u8FD0\u884C\u4E2D\u7684\u4E3B\u8981\u4F5C\u7528\u662F\uFF1F"
    options:
    - "\u4E3A\u7275\u5F15\u7535\u673A\u4F9B\u7535"
    - "\u4E3A\u63A7\u5236\u3001\u7167\u660E\u3001\u7A7A\u8C03\u7B49\u4F4E\u538B\u8D1F\u8F7D\u4F9B\u7535"
    - "\u76F4\u63A5\u9A71\u52A8\u8F6E\u5BF9"
    - "\u66FF\u4EE3\u53D7\u7535\u5F13\u4F9B\u7535"
    submittedOptionIndices: 00000000010000000200000003000000
    explanation: "\u8F85\u52A9\u4F9B\u7535\u7CFB\u7EDF\u4E3A\u5217\u8F66\u4F4E\u538B\u8D1F\u8F7D\u63D0\u4F9B\u7535\u6E90\uFF1B\u7275\u5F15\u7535\u673A\u7531\u7275\u5F15\u53D8\u6D41\u5668\u4F9B\u7535\uFF1BD\u5728\u6B63\u5E38\u8FD0\u884C\u4E2D\u4E0D\u53EF\u80FD\u3002"
  - questionId: bank_mc32
    prompt: "\u8F74\u7BB1\u8F74\u627F\u7EC4\u88C5\u65F6\uFF0C\u9700\u91C7\u7528\u70ED\u5957\u6CD5\u5C06\u8F74\u627F\u5185\u5708\u5B89\u88C5\u4E8E\u8F66\u8F74\u4E0A\uFF0C\u5176\u76EE\u7684\u662F\uFF1F"
    options:
    - "\u5229\u7528\u70ED\u80C0\u51B7\u7F29\u5B9E\u73B0\u8FC7\u76C8\u914D\u5408\uFF0C\u4FDD\u8BC1\u8FDE\u63A5\u7262\u56FA"
    - "\u6E05\u6D01\u8F74\u627F\u8868\u9762"
    - "\u68C0\u67E5\u8F74\u627F\u6750\u8D28"
    - "\u4FBF\u4E8E\u62C6\u5378"
    submittedOptionIndices: 01000000020000000300000000000000
    explanation: "\u70ED\u5957\u6CD5\u52A0\u70ED\u8F74\u627F\u5185\u5708\u4F7F\u5176\u81A8\u80C0\uFF0C\u5957\u5165\u8F66\u8F74\u540E\u51B7\u5374\u6536\u7F29\uFF0C\u5B9E\u73B0\u65E0\u635F\u4F24\u8FC7\u76C8\u914D\u5408\uFF0C\u4FDD\u8BC1\u4F20\u9012\u8F7D\u8377\u7684\u53EF\u9760\u6027\u3002"
  - questionId: bank_mc46
    prompt: "\u8F6C\u5411\u67B6\u7EF4\u4FEE\u7B56\u7565\u4E2D\u7684\u201C\u8BA1\u5212\u7EF4\u4FEE\u201D\u4E0E\u201C\u89C6\u60C5\u7EF4\u4FEE\u201D\u4E3B\u8981\u533A\u522B\u662F\uFF1F"
    options:
    - "\u8BA1\u5212\u7EF4\u4FEE\u4E0D\u9700\u8981\u505C\u5DE5"
    - "\u89C6\u60C5\u7EF4\u4FEE\u4E0D\u9700\u8981\u4EFB\u4F55\u6570\u636E"
    - "\u8BA1\u5212\u7EF4\u4FEE\u6210\u672C\u66F4\u4F4E"
