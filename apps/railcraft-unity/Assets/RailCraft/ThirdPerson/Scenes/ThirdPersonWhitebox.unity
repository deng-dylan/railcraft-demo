  sessionHost: {fileID: 443481445}
  inputLock: {fileID: 1287648357}
  quizDialogBehaviour: {fileID: 1538379279}
  questions:
  - questionId: bank_mc02
    prompt: "\u8F6C\u5411\u67B6\u901A\u5E38\u5B89\u88C5\u5728\u5217\u8F66\u7684\u4EC0\u4E48\u4F4D\u7F6E\uFF1F"
    options:
    - "\u8F66\u4F53\u5E95\u67B6\u4E0E\u94A2\u8F68\u4E4B\u95F4"
    - "\u8F66\u53A2\u8FDE\u63A5\u5904"
    - "\u8F66\u4F53\u5185\u90E8"
    - "\u8F66\u4F53\u9876\u90E8"
    submittedOptionIndices: 01000000020000000300000000000000
    explanation: "\u8F6C\u5411\u67B6\u4F4D\u4E8E\u8F66\u4F53\u5E95\u67B6\u4E0B\u65B9\u3001\u94A2\u8F68\u4E0A\u65B9\uFF0C\u662F\u8FDE\u63A5\u8F66\u4F53\u4E0E\u8F68\u9053\u7684\u4E2D\u95F4\u88C5\u7F6E\u3002A\u4E3A\u53D7\u7535\u5F13\u4F4D\u7F6E\uFF0CC\u4E3A\u8F66\u94A9\u4F4D\u7F6E\uFF0CD\u660E\u663E\u9519\u8BEF\u3002"
  - questionId: bank_mc16
    prompt: "\u9AD8\u94C1\u5217\u8F66\u4E2D\uFF0C\u7528\u4E8E\u4F20\u9012\u7275\u5F15\u529B\u548C\u5236\u52A8\u529B\uFF0C\u5E76\u5C06\u8F6E\u5BF9\u8F7D\u8377\u4F20\u9012\u7ED9\u6784\u67B6\u7684\u90E8\u4EF6\u662F\uFF1F"
    options:
    - "\u6297\u86C7\u884C\u51CF\u632F\u5668"
    - "\u7A7A\u6C14\u5F39\u7C27"
    - "\u8F74\u7BB1"
    - "\u7275\u5F15\u62C9\u6746"
    submittedOptionIndices: 02000000030000000000000001000000
    explanation: "\u8F74\u7BB1\u662F\u8F6E\u5BF9\u4E0E\u6784\u67B6\u7684\u8FDE\u63A5\u8282\u70B9\uFF0C\u4F20\u9012\u7275\u5F15/\u5236\u52A8\u529B\uFF0C\u540C\u65F6\u4FDD\u8BC1\u8F6E\u5BF9\u8F6C\u52A8\uFF1B\u7275\u5F15\u62C9\u6746\u4E3B\u8981\u4F20\u9012\u7EB5\u5411\u529B\uFF08\u8F66\u4F53-\u6784\u67B6\uFF09\uFF1B\u6297\u86C7\u884C\u51CF\u632F\u5668\u6291\u5236\u6A2A\u5411\u6446\u52A8\uFF1B\u7A7A\u6C14\u5F39\u7C27\u7528\u4E8E\u51CF\u632F\u3002"
  - questionId: bank_mc30
    prompt: "\u52A8\u8F66\u7EC4\u4E3B\u53D8\u6D41\u5668\uFF08\u7275\u5F15\u53D8\u6D41\u5668\uFF09\u5C06\u5355\u76F8\u4EA4\u6D41\u7535\u8F6C\u6362\u4E3A\u4E09\u76F8\u4EA4\u6D41\u7535\u4F9B\u7ED9\u7275\u5F15\u7535\u673A\uFF0C\u5176\u6838\u5FC3\u63A7\u5236\u76EE\u6807\u662F\uFF1F"
    options:
    - "\u4EC5\u7528\u4E8E\u542F\u52A8\u9636\u6BB5"
    - "\u7EF4\u6301\u6052\u5B9A\u7535\u538B"
    - "\u5B9E\u73B0\u7275\u5F15\u7535\u673A\u7684\u8C03\u901F\u548C\u8F6C\u77E9\u63A7\u5236"
    - "\u5C06\u7535\u80FD\u56DE\u9988\u81F3\u63A5\u89E6\u7F51"
