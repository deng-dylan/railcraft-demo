    - "\u51CF\u5C0F\u7535\u673A\u8F93\u51FA\u626D\u77E9"
    - "\u964D\u4F4E\u7C27\u4E0B\u8D28\u91CF\uFF0C\u51CF\u5C0F\u8F6E\u8F68\u52A8\u4F5C\u7528\u529B"
    - "\u589E\u52A0\u7C27\u4E0B\u8D28\u91CF\uFF0C\u63D0\u9AD8\u9ECF\u7740"
    submittedOptionIndices: 02000000030000000000000001000000
    explanation: "\u67B6\u60AC\u5F0F\u5C06\u7535\u673A\u56FA\u5B9A\u5728\u6784\u67B6\uFF08\u7C27\u4E0A\uFF09\uFF0C\u800C\u975E\u8F6E\u5BF9\uFF08\u7C27\u4E0B\uFF09\uFF0C\u663E\u8457\u964D\u4F4E\u7C27\u4E0B\u8D28\u91CF\uFF0C\u51CF\u5C0F\u8F6E\u8F68\u52A8\u6001\u51B2\u51FB\uFF1BB\u3001C\u3001D\u5747\u4E0D\u6B63\u786E\u3002"
