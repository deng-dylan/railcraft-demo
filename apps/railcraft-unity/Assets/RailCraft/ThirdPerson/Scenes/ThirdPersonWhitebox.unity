    submittedOptionIndices: 01000000020000000300000000000000
    explanation: "\u5F39\u7C27\u60AC\u6302\u88C5\u7F6E\u6309\u4F4D\u7F6E\u5206\u4E3A\u4E00\u7CFB\u60AC\u6302\uFF08\u8F6E\u5BF9\u4E0E\u6784\u67B6\u4E4B\u95F4\uFF0C\u4E3B\u8981\u7F13\u548C\u8F68\u9053\u4E0D\u5E73\u987A\u51B2\u51FB\uFF09\u548C\u4E8C\u7CFB\u60AC\u6302\uFF08\u6784\u67B6\u4E0E\u8F66\u4F53\u4E4B\u95F4\uFF0C\u4E3B\u8981\u63D0\u9AD8\u4E58\u5750\u8212\u9002\u6027\uFF09\u3002B\u662F\u6309\u63A7\u5236\u65B9\u5F0F\u5206\u7C7B\uFF0CC\u662F\u6309\u4ECB\u8D28\u5206\u7C7B\uFF0CD\u662F\u6C7D\u8F66\u672F\u8BED\u3002"
  - questionId: bank_mc24
    prompt: "\u7275\u5F15\u7535\u673A\u5728\u52A8\u8F66\u8F6C\u5411\u67B6\u4E2D\u901A\u5E38\u91C7\u7528\u67B6\u60AC\u5F0F\u5B89\u88C5\uFF0C\u5176\u4F18\u70B9\u662F\uFF1F"
    options:
