    explanation: "\u8F6C\u5411\u67B6\u7684\u4E3B\u8981\u529F\u80FD\u5305\u62EC\u627F\u8F7D\u3001\u5BFC\u5411\u3001\u51CF\u632F\u548C\u901A\u8FC7\u66F2\u7EBF\uFF0C\u4F46\u76F4\u63A5\u63D0\u4F9B\u7275\u5F15\u52A8\u529B\u662F\u7275\u5F15\u7535\u673A\uFF08\u52A8\u529B\u8F6C\u5411\u67B6\uFF09\u7684\u529F\u80FD\uFF0C\u800C\u975E\u8F6C\u5411\u67B6\u672C\u8EAB\u7684\u901A\u7528\u529F\u80FD\u3002\u975E\u52A8\u529B\u8F6C\u5411\u67B6\uFF08\u62D6\u8F66\u8F6C\u5411\u67B6\uFF09\u4E0D\u63D0\u4F9B\u7275\u5F15\u529B\u3002"
  - questionId: bank_mc15
    prompt: "\u57FA\u7840\u5236\u52A8\u88C5\u7F6E\uFF08\u5982\u76D8\u5F62\u5236\u52A8\uFF09\u5728\u9AD8\u94C1\u5217\u8F66\u4E2D\u7684\u4E3B\u8981\u4F5C\u7528\u662F\uFF1F"
    options:
    - "\u4E3A\u5217\u8F66\u63D0\u4F9B\u52A0\u901F\u52A8\u529B"
    - "\u8C03\u8282\u5217\u8F66\u7A7A\u8C03\u7CFB\u7EDF"
    - "\u63A7\u5236\u5217\u8F66\u7167\u660E"
    - "\u5C06\u5217\u8F66\u52A8\u80FD\u8F6C\u5316\u4E3A\u70ED\u80FD\uFF0C\u5B9E\u73B0\u51CF\u901F\u548C\u505C\u8F66"
    submittedOptionIndices: 01000000020000000300000000000000
    explanation: "\u5236\u52A8\u88C5\u7F6E\u901A\u8FC7\u6469\u64E6\u5C06\u52A8\u80FD\u8F6C\u4E3A\u70ED\u80FD\uFF0C\u4F7F\u5217\u8F66\u51CF\u901F\u6216\u505C\u8F66\uFF1BB\u662F\u7275\u5F15\u7CFB\u7EDF\u529F\u80FD\uFF1BC\u548CD\u4E3A\u8F85\u52A9\u7CFB\u7EDF\u3002"
  - questionId: bank_mc29
    prompt: "\u8F6E\u5BF9\u91C7\u7528\u7A7A\u5FC3\u8F66\u8F74\u8BBE\u8BA1\uFF0C\u5728\u9AD8\u901F\u5DE5\u51B5\u4E0B\u7684\u4E3B\u8981\u76EE\u7684\u662F\uFF1F"
    options:
    - "\u4FBF\u4E8E\u5B89\u88C5\u4F20\u611F\u5668"
    - "\u964D\u4F4E\u5236\u9020\u6210\u672C"
    - "\u964D\u4F4E\u7C27\u4E0B\u8D28\u91CF\uFF0C\u6539\u5584\u8F6E\u8F68\u52A8\u4F5C\u7528\u529B"
    - "\u63D0\u9AD8\u8F66\u8F74\u627F\u8F7D\u80FD\u529B"
    submittedOptionIndices: 02000000030000000000000001000000
    explanation: "\u7A7A\u5FC3\u8F66\u8F74\u5728\u4FDD\u8BC1\u5F3A\u5EA6\u7684\u540C\u65F6\u5927\u5E45\u51CF\u8F7B\u91CD\u91CF\uFF0C\u964D\u4F4E\u7C27\u4E0B\u8D28\u91CF\uFF0C\u51CF\u5C11\u8F6E\u8F68\u52A8\u4F5C\u7528\u529B\uFF0C\u63D0\u5347\u9AD8\u901F\u8FD0\u884C\u7A33\u5B9A\u6027\u3002"
  - questionId: bank_mc43
    prompt: "\u6570\u5B57\u5B6A\u751F\u6280\u672F\u4E2D\uFF0C\u521B\u5EFA\u77E5\u8BC6\u56FE\u8C31\u7684\u4E3B\u8981\u4F5C\u7528\u662F\uFF1F"
    options:
    - "\u4EC5\u7528\u4E8E\u6587\u6863\u7BA1\u7406"
    - "\u7528\u4E8E\u793E\u4EA4\u7F51\u7EDC\u5206\u6790"
    - "\u5B9E\u73B0\u6545\u969C\u5173\u7CFB\u62BD\u53D6\u548C\u667A\u80FD\u67E5\u8BE2\uFF0C\u8F85\u52A9\u5FEB\u901F\u5236\u5B9A\u7EF4\u4FEE\u7B56\u7565"
    - "\u66FF\u4EE3\u4F20\u611F\u5668"
    submittedOptionIndices: 03000000000000000100000002000000
    explanation: "\u77E5\u8BC6\u56FE\u8C31\u5C06\u6545\u969C\u6A21\u5F0F\u3001\u90E8\u4EF6\u5173\u7CFB\u3001\u7EF4\u4FEE\u7ECF\u9A8C\u7B49\u8FDB\u884C\u8BED\u4E49\u5316\u5173\u8054\uFF0C\u652F\u6301\u667A\u80FD\u95EE\u7B54\u548C\u63A8\u7406\uFF0C\u63D0\u9AD8\u6545\u969C\u5B9A\u4F4D\u6548\u7387\u3002"
  - questionId: bank_tf07
    prompt: "\u5728\u667A\u80FD\u8FD0\u7EF4\u4E2D\uFF0C\u72B6\u6001\u76D1\u6D4B\u7CFB\u7EDF\u53EF\u4EE5\u5B9E\u65F6\u83B7\u53D6\u8BBE\u5907\u8FD0\u884C\u6570\u636E\uFF0C\u4E3A\u89C6\u60C5\u7EF4\u4FEE\u63D0\u4F9B\u51B3\u7B56\u4F9D\u636E\u3002"
    options:
    - "\u6B63\u786E"
    - "\u9519\u8BEF"
    submittedOptionIndices: 0000000001000000
    explanation: "\u72B6\u6001\u76D1\u6D4B\u7CFB\u7EDF\u901A\u8FC7\u4F20\u611F\u5668\u5B9E\u65F6\u91C7\u96C6\u6E29\u5EA6\u3001\u632F\u52A8\u3001\u538B\u529B\u7B49\u6570\u636E\uFF0C\u4E3A\u89C6\u60C5\u7EF4\u4FEE\u63D0\u4F9B\u5BA2\u89C2\u4F9D\u636E\u3002"
  rewardPart: 0
  stationDisplayName: "\u8F66\u8F74\u77E5\u8BC6\u5DE5\u4F4D"
  rewardVisual: {fileID: 11536183}
  afterPickupObjective: "\u7EE7\u7EED\u6536\u96C6\u96F6\u4EF6\uFF0C\u6216\u524D\u5F80\u6D41\u7A0B\u56FE\u5BF9\u5E94\u7684\u88C5\u914D\u5DE5\u4F4D"
