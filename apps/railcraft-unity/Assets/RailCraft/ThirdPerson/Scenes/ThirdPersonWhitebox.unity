  m_Name: 
  m_EditorClassIdentifier: RailCraft.ThirdPerson.World::RailCraft.ThirdPerson.World.QuizPartStation
  sessionHost: {fileID: 443481445}
  inputLock: {fileID: 1287648357}
  quizDialogBehaviour: {fileID: 1538379279}
  questions:
  - questionId: bank_mc06
    prompt: "\u4EE5\u4E0B\u54EA\u9879\u4E0D\u5C5E\u4E8E\u8F6C\u5411\u67B6\u7684\u4E3B\u8981\u7EC4\u6210\u90E8\u5206\uFF1F"
    options:
    - "\u8F6E\u5BF9"
    - "\u53D1\u52A8\u673A"
    - "\u5F39\u7C27\u60AC\u6302\u7CFB\u7EDF"
    - "\u6784\u67B6"
    submittedOptionIndices: 01000000020000000300000000000000
    explanation: "\u8F6C\u5411\u67B6\u7684\u4E3B\u8981\u7EC4\u6210\u90E8\u5206\u5305\u62EC\u6784\u67B6\u3001\u8F6E\u5BF9\u3001\u8F74\u7BB1\u3001\u5F39\u7C27\u60AC\u6302\u7CFB\u7EDF\u3001\u57FA\u7840\u5236\u52A8\u88C5\u7F6E\u7B49\u3002\u53D1\u52A8\u673A\uFF08\u5185\u71C3\u673A\uFF09\u662F\u5185\u71C3\u673A\u8F66\u6216\u6C7D\u8F66\u7684\u672F\u8BED\uFF0C\u9AD8\u94C1\u52A8\u8F66\u7EC4\u4F7F\u7528\u7684\u662F\u7275\u5F15\u7535\u673A\uFF08\u7535\u52A8\u673A\uFF09\uFF0C\u4E14\u7275\u5F15\u7535\u673A\u4EC5\u5B58\u5728\u4E8E\u52A8\u529B\u8F6C\u5411\u67B6\uFF0C\u4E0D\u5C5E\u4E8E\u8F6C\u5411\u67B6\u7684\u901A\u7528\u7EC4\u6210\u90E8\u5206\u3002"
  - questionId: bank_mc20
    prompt: "\u52A8\u8F66\u7EC4\u8F66\u94A9\u7F13\u51B2\u88C5\u7F6E\u7684\u4E3B\u8981\u529F\u80FD\u662F\uFF1F"
    options:
    - "\u4E3A\u5217\u8F66\u63D0\u4F9B\u7275\u5F15\u52A8\u529B"
    - "\u63A7\u5236\u5217\u8F66\u884C\u9A76\u65B9\u5411"
    - "\u4EC5\u5B9E\u73B0\u673A\u68B0\u8FDE\u6302"
    - "\u5B9E\u73B0\u673A\u68B0\u3001\u7535\u6C14\u3001\u6C14\u8DEF\u7684\u8FDE\u6302\uFF0C\u5E76\u7F13\u51B2\u7EB5\u5411\u51B2\u51FB"
    submittedOptionIndices: 02000000030000000000000001000000
    explanation: "\u73B0\u4EE3\u52A8\u8F66\u7EC4\u8F66\u94A9\u4E3A\u5BC6\u63A5\u5F0F\uFF0C\u96C6\u6210\u4E86\u673A\u68B0\u8FDE\u63A5\u3001\u7535\u6C14\u8FDE\u63A5\u548C\u6C14\u8DEF\u8FDE\u63A5\uFF0C\u540C\u65F6\u7F13\u51B2\u5668\u5438\u6536\u7EB5\u5411\u51B2\u51FB\u3002"
  - questionId: bank_mc34
    prompt: "\u5728\u8F66\u4F53\u4E0E\u8F6C\u5411\u67B6\u8FDE\u63A5\uFF08\u4E8C\u7CFB\u60AC\u6302\uFF09\u7EC4\u88C5\u65F6\uFF0C\u9700\u6D4B\u91CF\u5E76\u8C03\u6574\u9AD8\u5EA6\u9600\u8FDE\u6746\u7684\u957F\u5EA6\uFF0C\u5176\u76EE\u7684\u662F\uFF1F"
    options:
    - "\u65B9\u4FBF\u7BA1\u8DEF\u8FDE\u63A5"
    - "\u4FDD\u8BC1\u8F66\u4F53\u5728\u4E0D\u540C\u8F7D\u8377\u4E0B\u5747\u5904\u4E8E\u8BBE\u8BA1\u9AD8\u5EA6"
    - "\u589E\u52A0\u7A7A\u6C14\u5F39\u7C27\u5BFF\u547D"
    - "\u8C03\u8282\u51CF\u632F\u5668\u963B\u5C3C"
    submittedOptionIndices: 03000000000000000100000002000000
    explanation: "\u9AD8\u5EA6\u9600\u8FDE\u6746\u7684\u957F\u5EA6\u51B3\u5B9A\u4E86\u9AD8\u5EA6\u9600\u7684\u5F00\u542F\u70B9\uFF0C\u6B63\u786E\u8C03\u6574\u53EF\u786E\u4FDD\u7A7A\u6C14\u5F39\u7C27\u5728\u4E0D\u540C\u8F7D\u8377\u4E0B\u5747\u5C06\u8F66\u4F53\u7EF4\u6301\u5728\u8BBE\u8BA1\u9AD8\u5EA6\u3002"
  - questionId: bank_mc48
    prompt: "\u4EE5\u4E0B\u54EA\u4E2A\u662F\u9AD8\u94C1\u667A\u80FD\u8FD0\u7EF4\u7684\u5178\u578B\u5E94\u7528\u573A\u666F\uFF1F"
    options:
    - "\u4F7F\u7528\u4F20\u7EDF\u542C\u97F3\u68D2\u68C0\u67E5\u8F74\u627F"
    - "\u5728\u4E09\u7EF4\u865A\u62DF\u73AF\u5883\u4E2D\u5FEB\u901F\u5B9A\u4F4D\u62A5\u8B66\u70B9\u4F4D\u5E76\u8C03\u53D6\u5468\u8FB9\u89C6\u9891"
    - "\u5168\u90E8\u4F9D\u9760\u4EBA\u5DE5\u7ECF\u9A8C\u5224\u65AD\u6545\u969C"
    - "\u5B9A\u671F\u505C\u673A\u8FDB\u884C\u7834\u574F\u6027\u68C0\u67E5"
    submittedOptionIndices: 00000000010000000200000003000000
    explanation: "\u4E09\u7EF4\u865A\u62DF\u73AF\u5883\u7ED3\u5408\u5B9E\u65F6\u6570\u636E\u548C\u89C6\u9891\u8054\u52A8\uFF0C\u662F\u6570\u5B57\u5B6A\u751F\u5728\u667A\u80FD\u8FD0\u7EF4\u4E2D\u7684\u5178\u578B\u5E94\u7528\uFF0C\u5927\u5E45\u63D0\u5347\u6545\u969C\u54CD\u5E94\u6548\u7387\u3002"
  rewardPart: 5
  stationDisplayName: "\u4F20\u611F\u5668\u5EA7\u77E5\u8BC6\u5DE5\u4F4D"
  rewardVisual: {fileID: 1633865912}
  afterPickupObjective: "\u7EE7\u7EED\u6536\u96C6\u96F6\u4EF6\uFF0C\u6216\u524D\u5F80\u6D41\u7A0B\u56FE\u5BF9\u5E94\u7684\u88C5\u914D\u5DE5\u4F4D"
