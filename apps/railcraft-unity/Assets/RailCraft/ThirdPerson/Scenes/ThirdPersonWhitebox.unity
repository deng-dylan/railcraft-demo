  m_Script: {fileID: 11500000, guid: 544e3e84ebbb4de8a153a438d98f4a79, type: 3}
  m_Name: 
  m_EditorClassIdentifier: RailCraft.ThirdPerson.World::RailCraft.ThirdPerson.World.QuizPartStation
  sessionHost: {fileID: 443481445}
  inputLock: {fileID: 1287648357}
  quizDialogBehaviour: {fileID: 1538379279}
  questions:
  - questionId: bank_mc09
    prompt: "\u4EE5\u4E0B\u54EA\u4E2A\u5C5E\u4E8E\u52A8\u529B\u8F6C\u5411\u67B6\u7279\u6709\u7684\u90E8\u4EF6\uFF1F"
    options:
    - "\u6784\u67B6"
    - "\u8F6E\u5BF9"
    - "\u7275\u5F15\u7535\u673A\u53CA\u9A71\u52A8\u88C5\u7F6E"
    - "\u57FA\u7840\u5236\u52A8\u88C5\u7F6E"
    submittedOptionIndices: 00000000010000000200000003000000
    explanation: "\u52A8\u529B\u8F6C\u5411\u67B6\uFF08\u52A8\u8F66\u8F6C\u5411\u67B6\uFF09\u76F8\u6BD4\u975E\u52A8\u529B\u8F6C\u5411\u67B6\uFF08\u62D6\u8F66\u8F6C\u5411\u67B6\uFF09\uFF0C\u7279\u6709\u7684\u90E8\u4EF6\u662F\u7275\u5F15\u7535\u673A\u3001\u9F7F\u8F6E\u7BB1\u3001\u8054\u8F74\u8282\u7B49\u9A71\u52A8\u88C5\u7F6E\u3002\u6784\u67B6\u3001\u8F6E\u5BF9\u3001\u57FA\u7840\u5236\u52A8\u88C5\u7F6E\u662F\u5404\u7C7B\u8F6C\u5411\u67B6\u5171\u6709\u7684\u3002"
  - questionId: bank_mc23
    prompt: "\u76D8\u5F62\u5236\u52A8\u88C5\u7F6E\u4E2D\uFF0C\u5236\u52A8\u5939\u94B3\u5C06\u95F8\u7247\u538B\u5411\u5236\u52A8\u76D8\uFF0C\u5176\u5236\u52A8\u529B\u5927\u5C0F\u4E3B\u8981\u53D6\u51B3\u4E8E\uFF1F"
    options:
    - "\u5236\u52A8\u7F38\u7A7A\u6C14\u538B\u529B\u53CA\u4F20\u52A8\u6548\u7387"
    - "\u8F66\u8F6E\u7684\u6750\u8D28"
    - "\u5217\u8F66\u884C\u9A76\u65B9\u5411"
    - "\u5236\u52A8\u76D8\u7684\u76F4\u5F84"
    submittedOptionIndices: 01000000020000000300000000000000
    explanation: "\u5236\u52A8\u529B\u7531\u5236\u52A8\u7F38\u538B\u529B\u7ECF\u6760\u6746\u673A\u6784\u653E\u5927\u540E\u4EA7\u751F\uFF0C\u53D6\u51B3\u4E8E\u8F93\u5165\u538B\u529B\u548C\u673A\u68B0\u6548\u7387\uFF1B\u5236\u52A8\u76D8\u76F4\u5F84\u5F71\u54CD\u5236\u52A8\u529B\u77E9\u800C\u975E\u529B\u672C\u8EAB\u3002"
  - questionId: bank_mc37
    prompt: "\u7EC4\u88C5\u7A7A\u6C14\u5F39\u7C27\u65F6\uFF0C\u9700\u8FDB\u884C\u6C14\u5BC6\u6027\u8BD5\u9A8C\uFF0C\u5176\u4FDD\u538B\u65F6\u95F4\u53CA\u5141\u8BB8\u6CC4\u6F0F\u7387\u901A\u5E38\u8981\u6C42\u4E3A\uFF1F"
    options:
    - "\u4FDD\u538B10\u5206\u949F\uFF0C\u5141\u8BB8\u5FAE\u91CF\u6CC4\u6F0F\uFF08\u538B\u964D\u2264\u89C4\u5B9A\u503C\uFF09"
    - "\u4FDD\u538B30\u79D2\u5373\u53EF"
    - "\u4FDD\u538B1\u5206\u949F\uFF0C\u65E0\u6CC4\u6F0F"
    - "\u4FDD\u538B5\u5206\u949F\uFF0C\u65E0\u6CC4\u6F0F"
    submittedOptionIndices: 02000000030000000000000001000000
    explanation: "\u90E8\u5206\u6807\u51C6\u4E3A\u4FDD\u538B10\u5206\u949F\uFF0C\u538B\u964D\u22640.1
      bar\u6216\u6309\u5177\u4F53\u5DE5\u827A\u8981\u6C42\u3002\u6C14\u5BC6\u6027\u662F\u7A7A\u6C14\u5F39\u7C27\u7684\u5173\u952E\u6027\u80FD\uFF0C\u9700\u8DB3\u591F\u4FDD\u538B\u65F6\u95F4\u9A8C\u8BC1\u5BC6\u5C01\u53EF\u9760\u6027\uFF0C\u5141\u8BB8\u6781\u5FAE\u91CF\u6CC4\u6F0F\uFF08\u7531\u5DE5\u827A\u6587\u4EF6\u89C4\u5B9A\uFF09\uFF0C\u4F46\u7EDD\u975E\u65E0\u6761\u4EF6\u201C\u65E0\u6CC4\u6F0F\u201D\u3002"
  - questionId: bank_tf01
    prompt: "\u6784\u67B6\u662F\u8F6C\u5411\u67B6\u7684\u57FA\u7840\uFF0C\u5B83\u5C06\u8F6C\u5411\u67B6\u7684\u5404\u4E2A\u96F6\u3001\u90E8\u4EF6\u7EC4\u6210\u4E00\u4E2A\u6574\u4F53\uFF0C\u56E0\u6B64\u4EC5\u9700\u627F\u53D7\u5782\u5411\u8F7D\u8377\u5373\u53EF\u3002"
    options:
    - "\u9519\u8BEF"
    - "\u6B63\u786E"
    submittedOptionIndices: 0100000000000000
    explanation: "\u6784\u67B6\u9700\u627F\u53D7\u5782\u5411\u3001\u6A2A\u5411\u3001\u7EB5\u5411\u591A\u5411\u8F7D\u8377\uFF0C\u5305\u62EC\u8F66\u4F53\u91CD\u529B\u3001\u7275\u5F15/\u5236\u52A8\u529B\u3001\u66F2\u7EBF\u79BB\u5FC3\u529B\u53CA\u8F68\u9053\u51B2\u51FB\u7B49\u3002"
