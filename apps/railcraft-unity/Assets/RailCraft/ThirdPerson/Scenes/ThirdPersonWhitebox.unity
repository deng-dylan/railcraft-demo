  questions:
  - questionId: bank_mc10
    prompt: "\u8F6C\u5411\u67B6\u7684\u5F39\u7C27\u60AC\u6302\u88C5\u7F6E\u6309\u4F4D\u7F6E\u5206\u4E3A\u54EA\u4E24\u79CD\uFF1F"
    options:
    - "\u4E3B\u52A8\u60AC\u6302\u548C\u88AB\u52A8\u60AC\u6302"
