  m_Script: {fileID: 11500000, guid: 544e3e84ebbb4de8a153a438d98f4a79, type: 3}
  m_Name: 
  m_EditorClassIdentifier: RailCraft.ThirdPerson.World::RailCraft.ThirdPerson.World.QuizPartStation
  sessionHost: {fileID: 443481445}
  inputLock: {fileID: 1287648357}
  quizDialogBehaviour: {fileID: 1538379279}
  questions:
  - questionId: bank_mc13
    prompt: "\u9AD8\u94C1\u8F66\u4F53\u901A\u5E38\u91C7\u7528\u94DD\u5408\u91D1\u6216\u590D\u5408\u6750\u6599\u5236\u9020\uFF0C\u4E3B\u8981\u76EE\u7684\u662F\uFF1F"
    options:
    - "\u63D0\u9AD8\u5BFC\u7535\u6027\u80FD"
    - "\u964D\u4F4E\u8F66\u4F53\u91CD\u91CF\u5E76\u4FDD\u8BC1\u5F3A\u5EA6"
    - "\u964D\u4F4E\u5236\u9020\u6210\u672C"
    - "\u4FBF\u4E8E\u710A\u63A5\u7EF4\u4FEE"
    submittedOptionIndices: 00000000010000000200000003000000
    explanation: "\u9AD8\u94C1\u5BF9\u8F7B\u91CF\u5316\u8981\u6C42\u6781\u9AD8\uFF0C\u94DD\u5408\u91D1\u548C\u590D\u5408\u6750\u6599\u5728\u4FDD\u8BC1\u5F3A\u5EA6\u7684\u540C\u65F6\u5927\u5E45\u51CF\u91CD\uFF0C\u4ECE\u800C\u964D\u4F4E\u80FD\u8017\u5E76\u63D0\u9AD8\u901F\u5EA6\u3002"
  - questionId: bank_mc27
    prompt: "\u53D7\u7535\u5F13\u7684\u5347\u5F13\u88C5\u7F6E\u901A\u5E38\u91C7\u7528\u538B\u7F29\u7A7A\u6C14\u9A71\u52A8\uFF0C\u5176\u4E3B\u8981\u4F18\u52BF\u662F\uFF1F"
    options:
    - "\u65E0\u9700\u7535\u6E90"
    - "\u7ED3\u6784\u6700\u7B80\u5355"
    - "\u6210\u672C\u6700\u4F4E"
    - "\u54CD\u5E94\u901F\u5EA6\u5FEB\uFF0C\u4E14\u80FD\u5728\u5931\u538B\u65F6\u81EA\u52A8\u964D\u5F13"
    submittedOptionIndices: 01000000020000000300000000000000
    explanation: "\u6C14\u52A8\u5347\u5F13\u54CD\u5E94\u5FEB\uFF0C\u4E14\u5F53\u4F9B\u98CE\u538B\u529B\u6D88\u5931\u65F6\uFF0C\u53D7\u7535\u5F13\u5728\u91CD\u529B\u6216\u5F39\u7C27\u529B\u4F5C\u7528\u4E0B\u81EA\u52A8\u964D\u5F13\uFF0C\u5B9E\u73B0\u5B89\u5168\u4FDD\u62A4\u3002"
  - questionId: bank_mc41
    prompt: "\u5728\u9AD8\u94C1\u667A\u80FD\u8FD0\u7EF4\u4E2D\uFF0C\u6570\u5B57\u5B6A\u751F\u6280\u672F\u7684\u4E3B\u8981\u5E94\u7528\u662F\uFF1F"
    options:
    - "\u4EC5\u7528\u4E8E3D\u5C55\u793A"
    - "\u964D\u4F4E\u5217\u8F66\u8FD0\u884C\u901F\u5EA6"
    - "\u66FF\u4EE3\u6240\u6709\u7269\u7406\u68C0\u4FEE"
    - "\u521B\u5EFA\u8F6C\u5411\u67B6\u865A\u62DF\u6A21\u578B\uFF0C\u5B9E\u73B0\u72B6\u6001\u5B9E\u65F6\u6620\u5C04\u4E0E\u6545\u969C\u9884\u6D4B"
    submittedOptionIndices: 02000000030000000000000001000000
    explanation: "\u6570\u5B57\u5B6A\u751F\u901A\u8FC7\u865A\u62DF\u6A21\u578B\u4E0E\u7269\u7406\u5B9E\u4F53\u5B9E\u65F6\u540C\u6B65\uFF0C\u5B9E\u73B0\u72B6\u6001\u76D1\u6D4B\u3001\u6545\u969C\u8BCA\u65AD\u548C\u5269\u4F59\u5BFF\u547D\u9884\u6D4B\uFF0C\u8F85\u52A9\u8FD0\u7EF4\u51B3\u7B56\u3002"
  - questionId: bank_tf05
    prompt: "\u5730\u94C1\u8F66\u8F86\u8FD0\u884C5\u5E74\u6216\u91CC\u7A0B\u8FBE\u523060\u4E07\u516C\u91CC\u5DE6\u53F3\u65F6\uFF0C\u901A\u5E38\u9700\u8981\u8FDB\u884C\u67B6\u4FEE\u4F5C\u4E1A\uFF0C\u4EE5\u6062\u590D\u4E3B\u8981\u6027\u80FD\u6307\u6807\u3002"
    options:
    - "\u9519\u8BEF"
    - "\u6B63\u786E"
    submittedOptionIndices: 0100000000000000
    explanation: "\u67B6\u4FEE\u662F\u5730\u94C1\u8F66\u8F86\u7684\u91CD\u8981\u5B9A\u671F\u68C0\u4FEE\u7EA7\u522B\uFF0C\u5468\u671F\u4E00\u822C\u4E3A5\u5E74\u621660\u4E07\u516C\u91CC\uFF08\u5177\u4F53\u8F66\u578B\u6709\u5DEE\u5F02\uFF09\uFF0C\u76EE\u6807\u662F\u6062\u590D\u4E3B\u8981\u6027\u80FD\u3002"
  rewardPart: 12
  stationDisplayName: "\u8F66\u4F53\u77E5\u8BC6\u5DE5\u4F4D"
  rewardVisual: {fileID: 1030372409}
  afterPickupObjective: "\u7EE7\u7EED\u6536\u96C6\u96F6\u4EF6\uFF0C\u6216\u524D\u5F80\u6D41\u7A0B\u56FE\u5BF9\u5E94\u7684\u88C5\u914D\u5DE5\u4F4D"
