  questions:
  - questionId: bank_mc12
    prompt: "\u4EE5\u4E0B\u54EA\u4E2A\u5C5E\u4E8E\u9AD8\u94C1\u52A8\u8F66\u7EC4\u7684\u975E\u52A8\u529B\u8F6C\u5411\u67B6\u7279\u6709\u7684\u4E3B\u8981\u529F\u80FD\uFF1F"
    options:
    - "\u8C03\u8282\u63A5\u89E6\u7F51\u7535\u538B"
    - "\u63D0\u4F9B\u7275\u5F15\u529B"
    - "\u627F\u53D7\u8F66\u4F53\u91CD\u91CF\u5E76\u5F15\u5BFC\u8F66\u8F86\u6CBF\u8F68\u9053\u8FD0\u884C"
    - "\u5C06\u7535\u80FD\u8F6C\u6362\u4E3A\u673A\u68B0\u80FD"
    submittedOptionIndices: 03000000000000000100000002000000
    explanation: "\u975E\u52A8\u529B\u8F6C\u5411\u67B6\uFF08\u62D6\u8F66\u8F6C\u5411\u67B6\uFF09\u4E0D\u8BBE\u7275\u5F15\u7535\u673A\uFF0C\u4E3B\u8981\u529F\u80FD\u662F\u627F\u8F7D\u3001\u5BFC\u5411\u548C\u4F20\u9012\u5236\u52A8\u8F7D\u8377\uFF1BA\u548CC\u662F\u52A8\u529B\u8F6C\u5411\u67B6\u7684\u529F\u80FD\uFF1BD\u4E0E\u63A5\u89E6\u7F51\u7535\u538B\u8C03\u8282\u65E0\u5173\u3002"
  - questionId: bank_mc26
    prompt: "\u6297\u4FA7\u6EDA\u626D\u6746\u88C5\u7F6E\u7684\u5DE5\u4F5C\u539F\u7406\u662F\uFF1F"
    options:
    - "\u901A\u8FC7\u626D\u6746\u626D\u8F6C\u4EA7\u751F\u53CD\u529B\u77E9\uFF0C\u6291\u5236\u8F66\u4F53\u4FA7\u503E"
    - "\u901A\u8FC7\u6DB2\u538B\u963B\u5C3C\u8870\u51CF\u5782\u5411\u632F\u52A8"
    - "\u901A\u8FC7\u5F39\u7C27\u538B\u7F29\u5438\u6536\u6A2A\u5411\u51B2\u51FB"
    - "\u901A\u8FC7\u8FDE\u6746\u673A\u6784\u8C03\u8282\u8F74\u8DDD"
    submittedOptionIndices: 00000000010000000200000003000000
    explanation: "\u5F53\u8F66\u4F53\u4FA7\u503E\u65F6\uFF0C\u626D\u6746\u53D1\u751F\u626D\u8F6C\uFF0C\u4EA7\u751F\u4E0E\u4FA7\u503E\u65B9\u5411\u76F8\u53CD\u7684\u5F39\u6027\u529B\u77E9\uFF0C\u4ECE\u800C\u6291\u5236\u4FA7\u6EDA\u3002"
  - questionId: bank_mc40
    prompt: "\u87BA\u7EB9\u8FDE\u63A5\u4EF6\u5728\u7EC4\u88C5\u524D\u9700\u6309\u8981\u6C42\u6D82\u87BA\u7EB9\u9501\u56FA\u80F6\uFF0C\u4E3B\u8981\u76EE\u7684\u662F\uFF1F"
    options:
    - "\u9632\u6B62\u87BA\u6813\u56E0\u632F\u52A8\u800C\u677E\u8131"
    - "\u5BC6\u5C01\u9632\u6F0F"
    - "\u589E\u52A0\u5BFC\u7535\u6027"
    - "\u6DA6\u6ED1\u87BA\u7EB9\uFF0C\u4FBF\u4E8E\u62E7\u7D27"
    submittedOptionIndices: 01000000020000000300000000000000
    explanation: "\u9501\u56FA\u80F6\u56FA\u5316\u540E\u586B\u5145\u87BA\u7EB9\u95F4\u9699\uFF0C\u589E\u5927\u6469\u64E6\u529B\uFF0C\u6709\u6548\u9632\u6B62\u632F\u52A8\u73AF\u5883\u4E0B\u87BA\u6813\u677E\u8131\uFF1BA\u662F\u6DA6\u6ED1\u8102\u4F5C\u7528\uFF1BC\u662F\u5BC6\u5C01\u80F6\u4F5C\u7528\u3002"
  - questionId: bank_tf04
    prompt: "\u5728\u8F6C\u5411\u67B6\u7EC4\u88C5\u5DE5\u827A\u4E2D\uFF0C\u9F7F\u8F6E\u7BB1\u3001\u7275\u5F15\u7535\u673A\u7B49\u90E8\u4EF6\u7684\u5B89\u88C5\u987A\u5E8F\u53EF\u4EE5\u968F\u610F\u8C03\u6574\uFF0C\u4E0D\u5F71\u54CD\u6700\u7EC8\u88C5\u914D\u8D28\u91CF\u3002"
    options:
    - "\u6B63\u786E"
    - "\u9519\u8BEF"
    submittedOptionIndices: 0000000001000000
    explanation: "\u5B89\u88C5\u987A\u5E8F\u6709\u4E25\u683C\u5DE5\u827A\u89C4\u5B9A\uFF0C\u9700\u8003\u8651\u88C5\u914D\u7A7A\u95F4\u3001\u5BF9\u4E2D\u7CBE\u5EA6\u548C\u5148\u88C5\u4EF6\u5BF9\u540E\u88C5\u4EF6\u7684\u5E72\u6D89\uFF0C\u968F\u610F\u8C03\u6574\u4F1A\u5BFC\u81F4\u65E0\u6CD5\u88C5\u914D\u6216\u7CBE\u5EA6\u4E0D\u8FBE\u6807\u3002"
