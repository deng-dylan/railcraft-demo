    explanation: "\u8F74\u7BB1\u662F\u8F6E\u5BF9\u4E0E\u6784\u67B6\u7684\u8FDE\u63A5\u8282\u70B9\uFF0C\u4F20\u9012\u7275\u5F15/\u5236\u52A8\u529B\uFF0C\u540C\u65F6\u4FDD\u8BC1\u8F6E\u5BF9\u8F6C\u52A8\uFF1B\u7275\u5F15\u62C9\u6746\u4E3B\u8981\u4F20\u9012\u7EB5\u5411\u529B\uFF08\u8F66\u4F53-\u6784\u67B6\uFF09\uFF1B\u6297\u86C7\u884C\u51CF\u632F\u5668\u6291\u5236\u6A2A\u5411\u6446\u52A8\uFF1B\u7A7A\u6C14\u5F39\u7C27\u7528\u4E8E\u51CF\u632F\u3002"
  - questionId: bank_mc30
    prompt: "\u52A8\u8F66\u7EC4\u4E3B\u53D8\u6D41\u5668\uFF08\u7275\u5F15\u53D8\u6D41\u5668\uFF09\u5C06\u5355\u76F8\u4EA4\u6D41\u7535\u8F6C\u6362\u4E3A\u4E09\u76F8\u4EA4\u6D41\u7535\u4F9B\u7ED9\u7275\u5F15\u7535\u673A\uFF0C\u5176\u6838\u5FC3\u63A7\u5236\u76EE\u6807\u662F\uFF1F"
    options:
    - "\u4EC5\u7528\u4E8E\u542F\u52A8\u9636\u6BB5"
    - "\u7EF4\u6301\u6052\u5B9A\u7535\u538B"
    - "\u5B9E\u73B0\u7275\u5F15\u7535\u673A\u7684\u8C03\u901F\u548C\u8F6C\u77E9\u63A7\u5236"
    - "\u5C06\u7535\u80FD\u56DE\u9988\u81F3\u63A5\u89E6\u7F51"
    submittedOptionIndices: 03000000000000000100000002000000
    explanation: "\u53D8\u6D41\u5668\u901A\u8FC7VVVF\uFF08\u53D8\u538B\u53D8\u9891\uFF09\u63A7\u5236\uFF0C\u5B9E\u73B0\u5BF9\u7275\u5F15\u7535\u673A\u8F6C\u901F\u548C\u8F6C\u77E9\u7684\u7CBE\u786E\u63A7\u5236\uFF0C\u6EE1\u8DB3\u52A0\u51CF\u901F\u9700\u6C42\uFF1BC\u662F\u518D\u751F\u5236\u52A8\u529F\u80FD\uFF1BD\u9519\u8BEF\u3002"
  - questionId: bank_mc44
    prompt: "\u4EE5\u4E0B\u54EA\u9879\u662F\u667A\u80FD\u8FD0\u7EF4\u4E2D\u5B9E\u73B0\u4ECE\u201C\u4EBA\u9632\u201D\u5230\u201C\u6280\u9632\u201D\u8F6C\u53D8\u7684\u5173\u952E\u6280\u672F\uFF1F"
    options:
    - "\u4EBA\u5DE5\u7ECF\u9A8C\u5224\u65AD"
    - "\u7269\u8054\u7F51\u611F\u77E5\u4E0E\u5B9E\u65F6\u76D1\u6D4B\u9884\u8B66"
    - "\u4F20\u7EDF\u7EB8\u8D28\u53F0\u8D26"
    - "\u5B9A\u671F\u4EBA\u5DE5\u5DE1\u68C0"
    submittedOptionIndices: 00000000010000000200000003000000
    explanation: "\u7269\u8054\u7F51\u611F\u77E5\u5B9E\u73B0\u5168\u5929\u5019\u81EA\u52A8\u76D1\u6D4B\u548C\u62A5\u8B66\uFF0C\u51CF\u5C11\u5BF9\u4EBA\u7684\u7ECF\u9A8C\u4F9D\u8D56\uFF0C\u662F\u201C\u6280\u9632\u201D\u7684\u6838\u5FC3\u6280\u672F\u57FA\u7840\u3002"
  - questionId: bank_tf08
    prompt: "\u6240\u6709\u87BA\u6813\u8FDE\u63A5\u4EF6\u7684\u7D27\u56FA\u529B\u77E9\u8981\u6C42\u76F8\u540C\uFF0C\u4E0D\u9700\u8981\u533A\u5206\u4E0D\u540C\u89C4\u683C\u548C\u90E8\u4F4D\u3002"
    options:
    - "\u9519\u8BEF"
    - "\u6B63\u786E"
    submittedOptionIndices: 0100000000000000
    explanation: "\u4E0D\u540C\u89C4\u683C\u3001\u7B49\u7EA7\u3001\u90E8\u4F4D\u7684\u87BA\u6813\u7D27\u56FA\u529B\u77E9\u5B8C\u5168\u4E0D\u540C\uFF0C\u5FC5\u987B\u4E25\u683C\u6309\u5DE5\u827A\u6587\u4EF6\u6267\u884C\uFF0C\u5426\u5219\u4F1A\u8FC7\u8F7D\u65AD\u88C2\u6216\u9884\u7D27\u529B\u4E0D\u8DB3\u3002"
  rewardPart: 1
  stationDisplayName: "\u8F66\u8F6E\u77E5\u8BC6\u5DE5\u4F4D"
  rewardVisual: {fileID: 2116784604}
  afterPickupObjective: "\u7EE7\u7EED\u6536\u96C6\u96F6\u4EF6\uFF0C\u6216\u524D\u5F80\u6D41\u7A0B\u56FE\u5BF9\u5E94\u7684\u88C5\u914D\u5DE5\u4F4D"
