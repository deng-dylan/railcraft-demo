  m_EditorClassIdentifier: RailCraft.ThirdPerson.World::RailCraft.ThirdPerson.World.QuizPartStation
  sessionHost: {fileID: 443481445}
  inputLock: {fileID: 1287648357}
  quizDialogBehaviour: {fileID: 1538379279}
  questions:
  - questionId: bank_mc03
    prompt: "\u4EE5\u4E0B\u54EA\u4E2A\u662F\u8F6C\u5411\u67B6\u7684\u57FA\u7840\u9AA8\u67B6\uFF0C\u7528\u4E8E\u8FDE\u63A5\u548C\u652F\u6491\u5176\u4ED6\u90E8\u4EF6\uFF1F"
    options:
    - "\u6784\u67B6"
    - "\u5F39\u7C27\u60AC\u6302\u7CFB\u7EDF"
    - "\u8F6E\u5BF9"
    - "\u8F74\u7BB1"
    submittedOptionIndices: 02000000030000000000000001000000
    explanation: "\u6784\u67B6\u662F\u8F6C\u5411\u67B6\u7684\u9AA8\u67B6\uFF0C\u6240\u6709\u5176\u4ED6\u90E8\u4EF6\uFF08\u8F6E\u5BF9\u3001\u8F74\u7BB1\u3001\u5F39\u7C27\u60AC\u6302\u3001\u5236\u52A8\u88C5\u7F6E\u7B49\uFF09\u90FD\u5B89\u88C5\u5728\u6784\u67B6\u4E0A\uFF0C\u5C06\u5176\u8FDE\u63A5\u4E3A\u4E00\u4E2A\u6574\u4F53\u3002\u8F6E\u5BF9\u662F\u8D70\u884C\u90E8\u4EF6\uFF0C\u8F74\u7BB1\u662F\u8FDE\u63A5\u8282\u70B9\uFF0C\u5F39\u7C27\u60AC\u6302\u662F\u51CF\u632F\u90E8\u4EF6\u3002"
  - questionId: bank_mc17
    prompt: "\u4EE5\u4E0B\u54EA\u4E2A\u5927\u578B\u90E8\u4EF6\u5C5E\u4E8E\u9AD8\u94C1\u5217\u8F66\u7684\u9AD8\u538B\u7535\u6C14\u7CFB\u7EDF\uFF1F"
    options:
    - "\u6297\u4FA7\u6EDA\u626D\u6746"
    - "\u8F6C\u5411\u67B6\u6784\u67B6"
    - "\u4E3B\u53D8\u538B\u5668"
    - "\u8F6E\u5BF9"
    submittedOptionIndices: 03000000000000000100000002000000
    explanation: "\u4E3B\u53D8\u538B\u5668\u662F\u9AD8\u538B\u7535\u6C14\u7CFB\u7EDF\u7684\u6838\u5FC3\u90E8\u4EF6\uFF0C\u7528\u4E8E\u964D\u538B\u4F9B\u7535\uFF1BA\u3001C\u3001D\u5747\u4E3A\u673A\u68B0\u7ED3\u6784\u90E8\u4EF6\u3002"
  - questionId: bank_mc31
    prompt: "\u5728\u8F6C\u5411\u67B6\u603B\u88C5\u5DE5\u827A\u6D41\u7A0B\u4E2D\uFF0C\u901A\u5E38\u5C06\u6784\u67B6\u4F5C\u4E3A\u57FA\u7840\u4EF6\u5148\u884C\u5B9A\u4F4D\u7EC4\u88C5\uFF0C\u4E3B\u8981\u539F\u56E0\u662F\uFF1F"
    options:
    - "\u6784\u67B6\u6700\u91CD\uFF0C\u4FBF\u4E8E\u540E\u7EED\u540A\u88C5"
    - "\u6784\u67B6\u662F\u88C5\u914D\u57FA\u51C6\uFF0C\u9700\u4FDD\u8BC1\u6C34\u5E73\u5EA6\u548C\u5404\u5B89\u88C5\u5EA7\u76F8\u5BF9\u4F4D\u7F6E\u7CBE\u5EA6"
    - "\u6784\u67B6\u6D82\u88C5\u5DE5\u5E8F\u8981\u6C42\u6700\u5148\u5B8C\u6210"
    - "\u6784\u67B6\u6210\u672C\u6700\u9AD8\uFF0C\u4F18\u5148\u5B89\u88C5\u4FBF\u4E8E\u4FDD\u62A4"
    submittedOptionIndices: 00000000010000000200000003000000
    explanation: "\u6784\u67B6\u662F\u6240\u6709\u90E8\u4EF6\u7684\u5B89\u88C5\u9AA8\u67B6\uFF0C\u4EE5\u5176\u4E3A\u57FA\u51C6\u624D\u80FD\u4FDD\u8BC1\u5404\u90E8\u4EF6\uFF08\u8F6E\u5BF9\u3001\u7535\u673A\u3001\u60AC\u6302\u7B49\uFF09\u7684\u76F8\u5BF9\u4F4D\u7F6E\u7CBE\u5EA6\uFF0C\u786E\u4FDD\u88C5\u914D\u8D28\u91CF\u3002"
  - questionId: bank_mc45
    prompt: "\u5728\u89C6\u60C5\u7EF4\u4FEE\u51B3\u7B56\u4E2D\uFF0C\u5A01\u5E03\u5C14\u6BD4\u4F8B\u5F3A\u5EA6\u6A21\u578B\u7528\u4E8E\u63CF\u8FF0\uFF1F"
    options:
    - "\u90E8\u4EF6\u5BFF\u547D\u5206\u5E03\u4E0E\u4F34\u968F\u53D8\u91CF\uFF08\u72B6\u6001\u53C2\u6570\uFF09\u4E4B\u95F4\u7684\u5173\u7CFB"
    - "\u90E8\u4EF6\u7684\u989C\u8272\u53D8\u5316"
    - "\u90E8\u4EF6\u7684\u91CD\u91CF\u53D8\u5316"
    - "\u90E8\u4EF6\u7684\u5236\u9020\u6210\u672C"
    submittedOptionIndices: 01000000020000000300000000000000
    explanation: "\u8BE5\u6A21\u578B\u5C06\u90E8\u4EF6\u5BFF\u547D\u5206\u5E03\u4E0E\u8FD0\u884C\u72B6\u6001\u7B49\u534F\u53D8\u91CF\u5173\u8054\uFF0C\u7528\u4E8E\u8BC4\u4F30\u52A8\u6001\u5931\u6548\u98CE\u9669\uFF0C\u6307\u5BFC\u7EF4\u4FEE\u65F6\u673A\u9009\u62E9\u3002"
