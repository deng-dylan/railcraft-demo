  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 544e3e84ebbb4de8a153a438d98f4a79, type: 3}
  m_Name: 
  m_EditorClassIdentifier: RailCraft.ThirdPerson.World::RailCraft.ThirdPerson.World.QuizPartStation
  sessionHost: {fileID: 443481445}
  inputLock: {fileID: 1287648357}
  quizDialogBehaviour: {fileID: 1538379279}
  questions:
  - questionId: bank_mc08
    prompt: "\u57CE\u5E02\u8F68\u9053\u4EA4\u901A\u8F66\u8F86\u8F6C\u5411\u67B6\u901A\u5E38\u91C7\u7528\u51E0\u8F74\u5F62\u5F0F\uFF1F"
    options:
    - "\u591A\u8F74"
    - "\u5355\u8F74"
    - "\u4E24\u8F74"
    - "\u4E09\u8F74"
    submittedOptionIndices: 03000000000000000100000002000000
    explanation: "\u57CE\u5E02\u8F68\u9053\u4EA4\u901A\u8F66\u8F86\uFF08\u5730\u94C1\u3001\u8F7B\u8F68\uFF09\u7684\u8F6C\u5411\u67B6\u7EDD\u5927\u591A\u6570\u4E3A\u4E24\u8F74\u8F6C\u5411\u67B6\uFF08\u4E00\u4E2A\u8F6C\u5411\u67B6\u4E0A\u67092\u4E2A\u8F6E\u5BF9\uFF09\uFF0C\u8FD9\u662F\u6700\u6210\u719F\u3001\u6700\u7ECF\u6D4E\u7684\u914D\u7F6E\u3002\u5355\u8F74\u5C11\u89C1\uFF0C\u4E09\u8F74\u548C\u591A\u8F74\u4E3B\u8981\u7528\u4E8E\u91CD\u8F7D\u673A\u8F66\u6216\u7279\u6B8A\u8F66\u8F86\u3002"
  - questionId: bank_mc22
    prompt: "\u9AD8\u94C1\u8F6C\u5411\u67B6\u91C7\u7528\u4E8C\u7CFB\u60AC\u6302\uFF08\u8F66\u4F53\u4E0E\u8F6C\u5411\u67B6\u4E4B\u95F4\uFF09\uFF0C\u5176\u6838\u5FC3\u76EE\u7684\u662F\uFF1F"
    options:
    - "\u589E\u5927\u8F74\u91CD\uFF0C\u63D0\u9AD8\u9ECF\u7740"
    - "\u9694\u79BB\u8F6C\u5411\u67B6\u4E0E\u8F66\u4F53\u4E4B\u95F4\u7684\u9AD8\u9891\u632F\u52A8\uFF0C\u63D0\u9AD8\u4E58\u5750\u8212\u9002\u6027"
    - "\u7B80\u5316\u7A7A\u6C14\u7BA1\u8DEF"
    - "\u964D\u4F4E\u8F6C\u5411\u67B6\u5236\u9020\u6210\u672C"
    submittedOptionIndices: 00000000010000000200000003000000
    explanation: "\u4E8C\u7CFB\u60AC\u6302\uFF08\u901A\u5E38\u4E3A\u7A7A\u6C14\u5F39\u7C27\uFF09\u4E3B\u8981\u9694\u79BB\u6765\u81EA\u8F6C\u5411\u67B6\u7684\u9AD8\u9891\u632F\u52A8\u548C\u51B2\u51FB\uFF0C\u63D0\u5347\u4E58\u5750\u8212\u9002\u6027\uFF1BA\u4E0E\u4E8C\u7CFB\u60AC\u6302\u65E0\u5173\uFF1BC\u3001D\u8BF4\u6CD5\u9519\u8BEF\u3002"
  - questionId: bank_mc36
    prompt: "\u67B6\u4FEE\uFF08\u5927\u4FEE\uFF09\u5468\u671F\u4E2D\uFF0C\u5BF9\u7275\u5F15\u7535\u673A\u901A\u5E38\u8981\u6C42\u8FDB\u884C\u7EDD\u7F18\u7535\u963B\u6D4B\u8BD5\uFF0C\u5176\u5408\u683C\u6807\u51C6\u4E00\u822C\u4E3A\uFF1F"
    options:
    - "\u2265100 M\u03A9\uFF08\u89C6\u7535\u538B\u7B49\u7EA7\u800C\u5B9A\uFF0C\u901A\u5E38\u6781\u9AD8\uFF09"
    - "\u22640.5 M\u03A9"
    - "\u4EC5\u4F5C\u5916\u89C2\u68C0\u67E5"
    - "\u22651 M\u03A9"
    submittedOptionIndices: 01000000020000000300000000000000
    explanation: "\u9AD8\u538B\u7275\u5F15\u7535\u673A\u7EDD\u7F18\u7535\u963B\u8981\u6C42\u6781\u9AD8\uFF0C\u4E00\u822C\u75282500V\u62165000V\u5146\u6B27\u8868\u6D4B\u91CF\uFF0C\u7EDD\u7F18\u7535\u963B\u503C\u901A\u5E38\u5728\u6570\u767E\u5146\u6B27\u4EE5\u4E0A\uFF08\u5177\u4F53\u6309\u8F66\u578B\u6280\u672F\u8981\u6C42\uFF09\u3002"
  - questionId: bank_mc50
    prompt: "\u667A\u80FD\u8FD0\u7EF4\u4E2D\uFF0C\u6A21\u7CCAC\u5747\u503C\u805A\u7C7B\u7B97\u6CD5\u53EF\u7528\u4E8E\uFF1F"
    options:
    - "\u5217\u8F66\u81EA\u52A8\u9A7E\u9A76"
    - "\u8F66\u7968\u4EF7\u683C\u8BA1\u7B97"
    - "\u56FE\u50CF\u7F8E\u5316"
    - "\u6839\u636E\u6545\u969C\u7279\u5F81\u91CF\u5E8F\u5217\u9884\u6D4B\u90E8\u4EF6\u53EF\u80FD\u51FA\u73B0\u7684\u6545\u969C\u7C7B\u578B"
    submittedOptionIndices: 02000000030000000000000001000000
    explanation: "\u8BE5\u7B97\u6CD5\u57FA\u4E8E\u5386\u53F2\u6545\u969C\u7279\u5F81\u8FDB\u884C\u805A\u7C7B\uFF0C\u8BC6\u522B\u4E0D\u540C\u6545\u969C\u7C7B\u578B\u5BF9\u5E94\u7684\u7279\u5F81\u6A21\u5F0F\uFF0C\u4ECE\u800C\u5BF9\u65B0\u6570\u636E\u5B9E\u73B0\u6545\u969C\u5206\u7C7B\u9884\u6D4B\u3002"
  rewardPart: 7
  stationDisplayName: "\u5B9A\u4F4D\u5143\u4EF6\u77E5\u8BC6\u5DE5\u4F4D"
  rewardVisual: {fileID: 1811480618}
  afterPickupObjective: "\u7EE7\u7EED\u6536\u96C6\u96F6\u4EF6\uFF0C\u6216\u524D\u5F80\u6D41\u7A0B\u56FE\u5BF9\u5E94\u7684\u88C5\u914D\u5DE5\u4F4D"
