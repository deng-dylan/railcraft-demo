  m_Script: {fileID: 11500000, guid: 544e3e84ebbb4de8a153a438d98f4a79, type: 3}
  m_Name: 
  m_EditorClassIdentifier: RailCraft.ThirdPerson.World::RailCraft.ThirdPerson.World.QuizPartStation
  sessionHost: {fileID: 2128962540}
  inputLock: {fileID: 977702187}
  quizDialogBehaviour: {fileID: 895290995}
  questions:
  - questionId: bank_mc10
    prompt: "\u8F6C\u5411\u67B6\u7684\u5F39\u7C27\u60AC\u6302\u88C5\u7F6E\u6309\u4F4D\u7F6E\u5206\u4E3A\u54EA\u4E24\u79CD\uFF1F"
    options:
    - "\u4E3B\u52A8\u60AC\u6302\u548C\u88AB\u52A8\u60AC\u6302"
    - "\u7A7A\u6C14\u60AC\u6302\u548C\u6DB2\u538B\u60AC\u6302"
    - "\u524D\u60AC\u6302\u548C\u540E\u60AC\u6302"
    - "\u4E00\u7CFB\u60AC\u6302\u548C\u4E8C\u7CFB\u60AC\u6302"
    submittedOptionIndices: 01000000020000000300000000000000
    explanation: "\u5F39\u7C27\u60AC\u6302\u88C5\u7F6E\u6309\u4F4D\u7F6E\u5206\u4E3A\u4E00\u7CFB\u60AC\u6302\uFF08\u8F6E\u5BF9\u4E0E\u6784\u67B6\u4E4B\u95F4\uFF0C\u4E3B\u8981\u7F13\u548C\u8F68\u9053\u4E0D\u5E73\u987A\u51B2\u51FB\uFF09\u548C\u4E8C\u7CFB\u60AC\u6302\uFF08\u6784\u67B6\u4E0E\u8F66\u4F53\u4E4B\u95F4\uFF0C\u4E3B\u8981\u63D0\u9AD8\u4E58\u5750\u8212\u9002\u6027\uFF09\u3002B\u662F\u6309\u63A7\u5236\u65B9\u5F0F\u5206\u7C7B\uFF0CC\u662F\u6309\u4ECB\u8D28\u5206\u7C7B\uFF0CD\u662F\u6C7D\u8F66\u672F\u8BED\u3002"
  - questionId: bank_mc24
    prompt: "\u7275\u5F15\u7535\u673A\u5728\u52A8\u8F66\u8F6C\u5411\u67B6\u4E2D\u901A\u5E38\u91C7\u7528\u67B6\u60AC\u5F0F\u5B89\u88C5\uFF0C\u5176\u4F18\u70B9\u662F\uFF1F"
    options:
    - "\u7B80\u5316\u7535\u673A\u51B7\u5374\u7CFB\u7EDF"
    - "\u51CF\u5C0F\u7535\u673A\u8F93\u51FA\u626D\u77E9"
    - "\u964D\u4F4E\u7C27\u4E0B\u8D28\u91CF\uFF0C\u51CF\u5C0F\u8F6E\u8F68\u52A8\u4F5C\u7528\u529B"
    - "\u589E\u52A0\u7C27\u4E0B\u8D28\u91CF\uFF0C\u63D0\u9AD8\u9ECF\u7740"
    submittedOptionIndices: 02000000030000000000000001000000
    explanation: "\u67B6\u60AC\u5F0F\u5C06\u7535\u673A\u56FA\u5B9A\u5728\u6784\u67B6\uFF08\u7C27\u4E0A\uFF09\uFF0C\u800C\u975E\u8F6E\u5BF9\uFF08\u7C27\u4E0B\uFF09\uFF0C\u663E\u8457\u964D\u4F4E\u7C27\u4E0B\u8D28\u91CF\uFF0C\u51CF\u5C0F\u8F6E\u8F68\u52A8\u6001\u51B2\u51FB\uFF1BB\u3001C\u3001D\u5747\u4E0D\u6B63\u786E\u3002"
  - questionId: bank_mc38
    prompt: "\u7EC4\u88C5\u524D\uFF0C\u56FE\u7EB8\u4E0A\u8981\u6C42\u9632\u8150\u5904\u7406\u7684\u96F6\u90E8\u4EF6\u5FC5\u987B\u7ECF\u786E\u8BA4\u540E\u4E0A\u8F66\uFF0C\u8FD9\u4F53\u73B0\u4E86\u4EC0\u4E48\u539F\u5219\uFF1F"
    options:
    - "\u8F7B\u91CF\u5316\u539F\u5219"
    - "\u6210\u672C\u63A7\u5236\u539F\u5219"
    - "\u5DE5\u827A\u89C4\u8303\u4E0E\u6807\u51C6\u5316\u539F\u5219"
    - "\u7F8E\u89C2\u4F18\u5148\u539F\u5219"
    submittedOptionIndices: 03000000000000000100000002000000
    explanation: "\u4E25\u683C\u6309\u7167\u56FE\u7EB8\u548C\u5DE5\u827A\u6587\u4EF6\u6267\u884C\u9632\u8150\u5904\u7406\uFF0C\u662F\u5DE5\u827A\u6807\u51C6\u5316\u548C\u89C4\u8303\u5316\u7684\u4F53\u73B0\uFF0C\u786E\u4FDD\u4EA7\u54C1\u8010\u4E45\u6027\uFF0C\u800C\u975E\u6210\u672C\u3001\u7F8E\u89C2\u6216\u8F7B\u91CF\u5316\u8003\u8651\u3002"
  - questionId: bank_tf02
    prompt: "\u8F74\u7BB1\u5B9A\u4F4D\u88C5\u7F6E\u7684\u57FA\u672C\u8981\u6C42\u662F\u5728\u7EB5\u5411\u548C\u6A2A\u5411\u5177\u6709\u9002\u5B9C\u7684\u5F39\u6027\u5B9A\u4F4D\u521A\u5EA6\uFF0C\u4EE5\u5B9E\u73B0\u826F\u597D\u7684\u5F39\u6027\u5B9A\u4F4D\u4F5C\u7528\u3002"
    options:
    - "\u6B63\u786E"
    - "\u9519\u8BEF"
    submittedOptionIndices: 0000000001000000
    explanation: "\u8F74\u7BB1\u5B9A\u4F4D\u521A\u5EA6\u76F4\u63A5\u5F71\u54CD\u8F6E\u5BF9\u7684\u6A2A\u5411\u548C\u7EB5\u5411\u8FD0\u52A8\u7279\u6027\uFF0C\u9002\u5B9C\u7684\u5F39\u6027\u521A\u5EA6\u53EF\u5E73\u8861\u5BFC\u5411\u6027\u80FD\u548C\u86C7\u884C\u7A33\u5B9A\u6027\u3002"
  rewardPart: 9
  stationDisplayName: "\u4E8C\u7CFB\u5F39\u6027\u5143\u4EF6\u77E5\u8BC6\u5DE5\u4F4D"
  rewardVisual: {fileID: 1711505816}
  afterPickupObjective: "\u7EE7\u7EED\u6536\u96C6\u96F6\u4EF6\uFF0C\u6216\u524D\u5F80\u6D41\u7A0B\u56FE\u5BF9\u5E94\u7684\u88C5\u914D\u5DE5\u4F4D"
