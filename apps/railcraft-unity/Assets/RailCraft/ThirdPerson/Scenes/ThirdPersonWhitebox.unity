MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 376613808}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 544e3e84ebbb4de8a153a438d98f4a79, type: 3}
  m_Name: 
  m_EditorClassIdentifier: RailCraft.ThirdPerson.World::RailCraft.ThirdPerson.World.QuizPartStation
  sessionHost: {fileID: 443481445}
  inputLock: {fileID: 1287648357}
  quizDialogBehaviour: {fileID: 1538379279}
  questions:
  - questionId: bank_mc07
    prompt: "\u8F6C\u5411\u67B6\u76F8\u5BF9\u4E8E\u8F66\u4F53\u53EF\u4EE5\u81EA\u7531\u56DE\u8F6C\u7684\u4E3B\u8981\u76EE\u7684\u662F\uFF1F"
    options:
    - "\u589E\u52A0\u8F7D\u91CD\u80FD\u529B"
    - "\u964D\u4F4E\u5236\u9020\u6210\u672C"
    - "\u63D0\u9AD8\u76F4\u7EBF\u8FD0\u884C\u901F\u5EA6"
    - "\u4FBF\u4E8E\u8F66\u8F86\u901A\u8FC7\u5C0F\u534A\u5F84\u66F2\u7EBF"
    submittedOptionIndices: 02000000030000000000000001000000
    explanation: "\u8F6C\u5411\u67B6\u901A\u8FC7\u4E2D\u5FC3\u9500\u6216\u7275\u5F15\u88C5\u7F6E\u4E0E\u8F66\u4F53\u8FDE\u63A5\uFF0C\u5141\u8BB8\u8F6C\u5411\u67B6\u76F8\u5BF9\u4E8E\u8F66\u4F53\u5728\u4E00\u5B9A\u89D2\u5EA6\u5185\u81EA\u7531\u56DE\u8F6C\uFF0C\u4F7F\u8F6E\u5BF9\u80FD\u591F\u6CBF\u66F2\u7EBF\u8F68\u9053\u65B9\u5411\u8FD0\u884C\uFF0C\u51CF\u5C11\u8F6E\u8F68\u78E8\u8017\u548C\u4FA7\u5411\u529B\uFF0C\u4FBF\u4E8E\u901A\u8FC7\u5C0F\u534A\u5F84\u66F2\u7EBF\u3002"
  - questionId: bank_mc21
    prompt: "\u8F66\u8F6E\u8E0F\u9762\u91C7\u7528\u9525\u5F62\u8BBE\u8BA1\uFF0C\u5728\u66F2\u7EBF\u4E0A\u8FD0\u884C\u65F6\uFF0C\u5176\u81EA\u52A8\u9002\u5E94\u5185\u5916\u8F68\u957F\u5EA6\u5DEE\u7684\u4E3B\u8981\u539F\u7406\u662F\uFF1F"
    options:
    - "\u91C7\u7528\u72EC\u7ACB\u65CB\u8F6C\u8F66\u8F6E\u6D88\u9664\u8F6E\u5F84\u5DEE"
    - "\u5916\u8F6E\u6EDA\u52A8\u5706\u534A\u5F84\u589E\u5927\uFF0C\u5185\u8F6E\u51CF\u5C0F"
    - "\u5185\u5916\u8F6E\u76F4\u5F84\u76F8\u540C\uFF0C\u901A\u8FC7\u6ED1\u52A8\u8865\u507F"
    - "\u8F66\u8F6E\u8E0F\u9762\u4E3A\u5706\u67F1\u5F62\uFF0C\u4F9D\u9760\u8F6E\u7F18\u5BFC\u5411"
    submittedOptionIndices: 03000000000000000100000002000000
    explanation: "\u9525\u5F62\u8E0F\u9762\u4F7F\u8F6E\u5BF9\u5728\u66F2\u7EBF\u4E0A\u6A2A\u5411\u79FB\u52A8\u65F6\uFF0C\u5916\u8F6E\u4E0E\u94A2\u8F68\u63A5\u89E6\u70B9\u5BF9\u5E94\u8F83\u5927\u534A\u5F84\uFF0C\u5185\u8F6E\u5BF9\u5E94\u8F83\u5C0F\u534A\u5F84\uFF0C\u4ECE\u800C\u5339\u914D\u5185\u5916\u8F68\u957F\u5EA6\u5DEE\uFF0C\u51CF\u5C11\u6ED1\u52A8\u3002"
  - questionId: bank_mc35
    prompt: "\u9AD8\u94C1\u5217\u8F66\u8F6E\u5BF9\u7684\u955F\u4FEE\uFF08\u8F66\u8F6E\u8E0F\u9762\u4FEE\u7406\uFF09\u52A0\u5DE5\u540E\uFF0C\u9700\u8FDB\u884C\u52A8\u5E73\u8861\u8BD5\u9A8C\uFF0C\u5176\u6807\u51C6\u8981\u6C42\u901A\u5E38\u662F\uFF1F"
    options:
    - "\u6B8B\u4F59\u4E0D\u5E73\u8861\u91CF\u4E0D\u8D85\u8FC7\u89C4\u5B9A\u503C\uFF08\u5982\u22645
      g\xB7m\uFF09"
    - "\u5B8C\u5168\u6D88\u9664\u4E0D\u5E73\u8861"
    - "\u4EC5\u4F5C\u9759\u5E73\u8861"
    - "\u65E0\u9700\u8BD5\u9A8C\uFF0C\u76EE\u89C6\u68C0\u67E5\u5373\u53EF"
    submittedOptionIndices: 00000000010000000200000003000000
    explanation: "\u8F6E\u5BF9\u52A8\u5E73\u8861\u6709\u4E25\u683C\u6B8B\u4F59\u4E0D\u5E73\u8861\u91CF\u9650\u503C\uFF08\u5177\u4F53\u6570\u503C\u56E0\u8F66\u578B\u800C\u5F02\uFF09\uFF0C\u5B8C\u5168\u6D88\u9664\u4E0D\u5E73\u8861\u4E0D\u73B0\u5B9E\uFF0C\u9759\u5E73\u8861\u4E0D\u8DB3\u4EE5\u53CD\u6620\u9AD8\u901F\u52A8\u6001\u6027\u80FD\u3002"
  - questionId: bank_mc49
    prompt: "\u4E3A\u4F18\u5316\u7EF4\u4FEE\u51B3\u7B56\uFF0C\u5EFA\u7ACB\u201C\u91CD\u8981\u529F\u80FD\u90E8\u4EF6\u8BC4\u4F30\u6A21\u578B\u201D\u7684\u4E3B\u8981\u4F5C\u7528\u662F\uFF1F"
    options:
    - "\u4E3A\u5173\u952E\u96F6\u90E8\u4EF6\u7684\u7EF4\u4FEE\u65B9\u5F0F\uFF08\u9884\u9632\u6027\u7EF4\u4FEE\u3001\u89C6\u60C5\u7EF4\u4FEE\u7B49\uFF09\u9009\u62E9\u63D0\u4F9B\u4F9D\u636E"
    - "\u8BA1\u7B97\u90E8\u4EF6\u6298\u65E7\u7387"
    - "\u8BC4\u4F30\u90E8\u4EF6\u62A5\u5E9F\u4EF7\u503C"
    - "\u786E\u5B9A\u90E8\u4EF6\u5916\u89C2\u989C\u8272"
    submittedOptionIndices: 01000000020000000300000000000000
    explanation: "\u8BE5\u6A21\u578B\u901A\u8FC7\u5BF9\u90E8\u4EF6\u6545\u969C\u6A21\u5F0F\u3001\u540E\u679C\u3001\u98CE\u9669\u8FDB\u884C\u8BC4\u5206\uFF0C\u8F85\u52A9\u786E\u5B9A\u6700\u5408\u9002\u7684\u7EF4\u4FEE\u7B56\u7565\u3002"
  rewardPart: 6
  stationDisplayName: "\u4E00\u7CFB\u5F39\u6027\u5143\u4EF6\u77E5\u8BC6\u5DE5\u4F4D"
  rewardVisual: {fileID: 903187611}
  afterPickupObjective: "\u7EE7\u7EED\u6536\u96C6\u96F6\u4EF6\uFF0C\u6216\u524D\u5F80\u6D41\u7A0B\u56FE\u5BF9\u5E94\u7684\u88C5\u914D\u5DE5\u4F4D"
