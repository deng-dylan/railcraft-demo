  m_Script: {fileID: 11500000, guid: 544e3e84ebbb4de8a153a438d98f4a79, type: 3}
  m_Name: 
  m_EditorClassIdentifier: RailCraft.ThirdPerson.World::RailCraft.ThirdPerson.World.QuizPartStation
  sessionHost: {fileID: 443481445}
  inputLock: {fileID: 1287648357}
  quizDialogBehaviour: {fileID: 1538379279}
  questions:
  - questionId: bank_mc11
    prompt: "\u9AD8\u901F\u5217\u8F66\u4E2D\uFF0C\u7528\u4E8E\u4ECE\u63A5\u89E6\u7F51\u83B7\u53D6\u7535\u80FD\u7684\u53D7\u6D41\u88C5\u7F6E\u662F\uFF1F"
    options:
    - "\u4E3B\u65AD\u8DEF\u5668"
    - "\u7275\u5F15\u53D8\u6D41\u5668"
    - "\u53D7\u7535\u5F13"
    - "\u96C6\u7535\u9774"
    submittedOptionIndices: 02000000030000000000000001000000
    explanation: "\u53D7\u7535\u5F13\u662F\u9AD8\u94C1\u4ECE\u63A5\u89E6\u7F51\u83B7\u53D6\u7535\u80FD\u7684\u6838\u5FC3\u53D7\u6D41\u88C5\u7F6E\uFF1B\u96C6\u7535\u9774\u7528\u4E8E\u7B2C\u4E09\u8F68\u4F9B\u7535\uFF08\u5730\u94C1\u5E38\u89C1\uFF09\uFF1B\u4E3B\u65AD\u8DEF\u5668\u7528\u4E8E\u901A\u65AD\u9AD8\u538B\u7535\u8DEF\uFF1B\u7275\u5F15\u53D8\u6D41\u5668\u7528\u4E8E\u7535\u80FD\u53D8\u6362\u3002"
  - questionId: bank_mc25
    prompt: "\u7A7A\u6C14\u5F39\u7C27\u4E0E\u87BA\u65CB\u5F39\u7C27\u76F8\u6BD4\uFF0C\u5728\u9AD8\u94C1\u4E8C\u7CFB\u60AC\u6302\u4E2D\u7684\u7A81\u51FA\u4F18\u52BF\u662F\uFF1F"
    options:
    - "\u5BFF\u547D\u65E0\u9650\u957F"
    - "\u521A\u5EA6\u4E0D\u53EF\u8C03\uFF0C\u7A33\u5B9A\u6027\u597D"
    - "\u80FD\u901A\u8FC7\u9AD8\u5EA6\u63A7\u5236\u9600\u81EA\u52A8\u8C03\u8282\u8F66\u4F53\u9AD8\u5EA6\uFF0C\u9002\u5E94\u8F7D\u8377\u53D8\u5316"
    - "\u65E0\u9700\u9644\u52A0\u4F9B\u98CE\u7CFB\u7EDF"
    submittedOptionIndices: 03000000000000000100000002000000
    explanation: "\u7A7A\u6C14\u5F39\u7C27\u901A\u8FC7\u9AD8\u5EA6\u63A7\u5236\u9600\u5728\u4E0D\u540C\u8F7D\u8377\u4E0B\u4FDD\u6301\u8F66\u4F53\u9AD8\u5EA6\u6052\u5B9A\uFF0C\u4E14\u521A\u5EA6\u53EF\u8C03\uFF1BA\u3001C\u3001D\u5747\u9519\u8BEF\u3002"
  - questionId: bank_mc39
    prompt: "\u8C03\u6574\u57AB\u7684\u6570\u91CF\u5728\u5206\u89E3\u65F6\u5FC5\u987B\u51C6\u786E\u8BB0\u5F55\uFF0C\u4E3B\u8981\u539F\u56E0\u662F\uFF1F"
    options:
    - "\u57AB\u7247\u6210\u672C\u9AD8"
    - "\u57AB\u7247\u96BE\u4EE5\u91C7\u8D2D"
    - "\u8C03\u6574\u57AB\u6570\u91CF\u53D6\u51B3\u4E8E\u52A0\u5DE5\u9636\u6BB5\u7684\u8C03\u6574\u5C3A\u5BF8\uFF0C\u4FBF\u4E8E\u540E\u7EED\u6062\u590D\u88C5\u914D\u7CBE\u5EA6"
    - "\u57AB\u7247\u5BB9\u6613\u4E22\u5931"
    submittedOptionIndices: 00000000010000000200000003000000
    explanation: "\u8F6C\u5411\u67B6\u5404\u90E8\u4EF6\u52A0\u5DE5\u516C\u5DEE\u79EF\u7D2F\u9700\u901A\u8FC7\u8C03\u6574\u57AB\u8865\u507F\uFF0C\u5206\u89E3\u65F6\u8BB0\u5F55\u539F\u57AB\u7247\u6570\u91CF\u548C\u4F4D\u7F6E\uFF0C\u53EF\u5728\u91CD\u88C5\u65F6\u5FEB\u901F\u6062\u590D\u539F\u6709\u914D\u5408\u5C3A\u5BF8\uFF0C\u4FDD\u8BC1\u7CBE\u5EA6\u3002"
  - questionId: bank_tf03
    prompt: "\u7A7A\u6C14\u5F39\u7C27\u56E0\u7ED3\u6784\u7B80\u5355\u3001\u6210\u672C\u4F4E\u5EC9\uFF0C\u5728\u73B0\u4EE3\u9AD8\u901F\u5217\u8F66\u4E0A\u5F97\u5230\u4E86\u5E7F\u6CDB\u5E94\u7528\u3002"
    options:
    - "\u9519\u8BEF"
    - "\u6B63\u786E"
    submittedOptionIndices: 0100000000000000
    explanation: "\u7A7A\u6C14\u5F39\u7C27\u7ED3\u6784\u590D\u6742\u3001\u6210\u672C\u8F83\u9AD8\uFF0C\u4F46\u56E0\u6027\u80FD\u4F18\u8D8A\uFF08\u521A\u5EA6\u53EF\u8C03\u3001\u9AD8\u9891\u9694\u79BB\u597D\uFF09\u624D\u5728\u9AD8\u94C1\u4E0A\u5E7F\u6CDB\u5E94\u7528\u3002"
  rewardPart: 10
  stationDisplayName: "\u9AD8\u5EA6\u63A7\u5236\u5143\u4EF6\u77E5\u8BC6\u5DE5\u4F4D"
  rewardVisual: {fileID: 22320083}
