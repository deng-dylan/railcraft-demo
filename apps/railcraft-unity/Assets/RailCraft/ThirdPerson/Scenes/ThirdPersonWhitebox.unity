--- !u!114 &965357899
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 965357897}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 544e3e84ebbb4de8a153a438d98f4a79, type: 3}
  m_Name: 
  m_EditorClassIdentifier: RailCraft.ThirdPerson.World::RailCraft.ThirdPerson.World.QuizPartStation
  sessionHost: {fileID: 443481445}
  inputLock: {fileID: 1287648357}
  quizDialogBehaviour: {fileID: 1538379279}
  questions:
  - questionId: bank_mc05
    prompt: "\u8F74\u7BB1\u88C5\u7F6E\u5728\u8F6C\u5411\u67B6\u4E2D\u7684\u4E3B\u8981\u529F\u80FD\u662F\uFF1F"
    options:
    - "\u8FDE\u63A5\u8F6E\u5BF9\u4E0E\u6784\u67B6\uFF0C\u4FDD\u8BC1\u8F6E\u5BF9\u8F6C\u52A8\u5E76\u4F20\u9012\u4F5C\u7528\u529B"
    - "\u627F\u62C5\u8F66\u4F53\u5168\u90E8\u91CD\u91CF"
    - "\u4EA7\u751F\u5236\u52A8\u529B"
    - "\u9A71\u52A8\u8F6E\u5BF9\u65CB\u8F6C"
    submittedOptionIndices: 00000000010000000200000003000000
    explanation: "\u8F74\u7BB1\u5B89\u88C5\u5728\u8F66\u8F74\u4E24\u7AEF\uFF0C\u5185\u90E8\u88C5\u6709\u8F74\u627F\uFF0C\u4F7F\u8F6E\u5BF9\u53EF\u4EE5\u81EA\u7531\u65CB\u8F6C\uFF0C\u540C\u65F6\u5C06\u8F6E\u5BF9\u4E0E\u6784\u67B6\u8FDE\u63A5\u8D77\u6765\uFF0C\u4F20\u9012\u5404\u5411\u4F5C\u7528\u529B\u3002B\u7531\u8F6E\u5BF9\u548C\u60AC\u6302\u5171\u540C\u627F\u62C5\uFF0CC\u7531\u5236\u52A8\u88C5\u7F6E\u5B8C\u6210\uFF0CD\u7531\u7275\u5F15\u7535\u673A\u5B8C\u6210\u3002"
  - questionId: bank_mc19
    prompt: "\u4EE5\u4E0B\u54EA\u4E2A\u662F\u9AD8\u94C1\u5217\u8F66\u4E2D\u5E38\u89C1\u7684\u6297\u86C7\u884C\u8FD0\u52A8\u88C5\u7F6E\uFF1F"
    options:
    - "\u6297\u86C7\u884C\u51CF\u632F\u5668"
    - "\u5782\u5411\u51CF\u632F\u5668"
    - "\u8F74\u7BB1\u5F39\u7C27"
    - "\u6A2A\u5411\u6B62\u6321"
    submittedOptionIndices: 01000000020000000300000000000000
    explanation: "\u6297\u86C7\u884C\u51CF\u632F\u5668\u4E13\u95E8\u7528\u4E8E\u6291\u5236\u8F6C\u5411\u67B6\u76F8\u5BF9\u4E8E\u8F66\u4F53\u7684\u6A2A\u5411\u6446\u52A8\uFF08\u86C7\u884C\u8FD0\u52A8\uFF09\uFF0C\u786E\u4FDD\u9AD8\u901F\u7A33\u5B9A\u6027\uFF1BA\u9650\u5236\u6A2A\u5411\u4F4D\u79FB\uFF1BC\u8870\u51CF\u5782\u5411\u632F\u52A8\uFF1BD\u4E3A\u5F39\u6027\u652F\u6491\u3002"
  - questionId: bank_mc33
    prompt: "\u8F6C\u5411\u67B6\u5173\u952E\u87BA\u6813\uFF08\u5982\u8F74\u7BB1\u7AEF\u76D6\u87BA\u6813\uFF09\u7684\u7D27\u56FA\u626D\u77E9\u901A\u5E38\u91C7\u7528\u626D\u77E9\u6CD5+\u8F6C\u89D2\u6CD5\uFF0C\u5176\u4E3B\u8981\u539F\u56E0\u662F\uFF1F"
    options:
    - "\u51CF\u5C11\u5DE5\u5177\u78E8\u635F"
    - "\u4FBF\u4E8E\u76EE\u89C6\u68C0\u67E5"
    - "\u63D0\u9AD8\u62E7\u7D27\u6548\u7387"
    - "\u786E\u4FDD\u87BA\u6813\u83B7\u5F97\u7A33\u5B9A\u7684\u9884\u7D27\u529B\uFF0C\u9632\u6B62\u632F\u52A8\u677E\u8131"
    submittedOptionIndices: 02000000030000000000000001000000
    explanation: "\u626D\u77E9\u6CD5+\u8F6C\u89D2\u6CD5\u80FD\u66F4\u7CBE\u786E\u5730\u63A7\u5236\u87BA\u6813\u9884\u7D27\u529B\uFF0C\u907F\u514D\u56E0\u6469\u64E6\u7CFB\u6570\u6CE2\u52A8\u5BFC\u81F4\u7684\u9884\u7D27\u529B\u4E0D\u8DB3\u6216\u8FC7\u5927\uFF0C\u786E\u4FDD\u5728\u632F\u52A8\u5DE5\u51B5\u4E0B\u4E0D\u677E\u8131\u3002"
  - questionId: bank_mc47
    prompt: "\u5728\u6570\u5B57\u5B6A\u751F\u6A21\u578B\u4E2D\uFF0C\u5C06\u5B9E\u65F6\u76D1\u6D4B\u6570\u636E\u4E0E\u5386\u53F2\u6570\u636E\u7ED3\u5408\u8FDB\u884C\u5206\u6790\u7684\u4E3B\u8981\u76EE\u7684\u662F\uFF1F"
    options:
    - "\u964D\u4F4E\u6570\u636E\u91C7\u96C6\u9891\u7387"
    - "\u63D0\u9AD8\u6570\u636E\u5B58\u50A8\u91CF"
    - "\u5B9E\u73B0\u66F4\u51C6\u786E\u7684\u72B6\u6001\u8BC4\u4EF7\u548C\u6545\u969C\u9884\u6D4B"
    - "\u589E\u52A0\u7F51\u7EDC\u5E26\u5BBD\u5360\u7528"
    submittedOptionIndices: 03000000000000000100000002000000
    explanation: "\u5B9E\u65F6\u6570\u636E\u53CD\u6620\u5F53\u524D\u72B6\u6001\uFF0C\u5386\u53F2\u6570\u636E\u63D0\u4F9B\u8D8B\u52BF\u57FA\u51C6\uFF0C\u4E24\u8005\u878D\u5408\u53EF\u63D0\u9AD8\u9884\u6D4B\u51C6\u786E\u6027\u548C\u53EF\u9760\u6027\u8BC4\u4EF7\u3002"
  rewardPart: 4
  stationDisplayName: "\u7275\u5F15\u62C9\u6746\u77E5\u8BC6\u5DE5\u4F4D"
  rewardVisual: {fileID: 1439524468}
  afterPickupObjective: "\u7EE7\u7EED\u6536\u96C6\u96F6\u4EF6\uFF0C\u6216\u524D\u5F80\u6D41\u7A0B\u56FE\u5BF9\u5E94\u7684\u88C5\u914D\u5DE5\u4F4D"
